<Window x:Class="Project1.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="550" Width="450" 
        WindowStartupLocation="CenterOwner"
        Background="#1E293B" Foreground="#E2E8F0"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Контент с прокруткой -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="ℹ️ О программе" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="Расписание Колледжа v1.0.0" FontSize="14" 
                           Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- КОНТЕНТ С ПРОКРУТКОЙ (ИСПРАВЛЕНИЕ) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="#0F172A" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👤 Разработчик:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Земцова Елизавета Андреевна" FontSize="16" Foreground="#C7D2FE" Margin="0,0,0,15"/>

                        <TextBlock Text="🎓 Группа:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="22о" FontSize="16" Foreground="#C7D2FE" Margin="0,0,0,15"/>

                        <Separator Background="#334155" Margin="0,10,0,10"/>

                        <TextBlock Text="📝 Описание:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#94A3B8" LineHeight="20">
Система управления расписанием колледжа. Позволяет администраторам создавать, редактировать и просматривать расписание занятий для групп, отслеживать нагрузку преподавателей и формировать отчёты в форматах PDF и Excel. Реализована с использованием WPF (.NET 8), SQLite и паттерна MVVM.                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Кнопка закрытия -->
            <Button Grid.Row="2" Content="← Назад" Click="Close_Click" 
                    HorizontalAlignment="Center" Margin="0,20,0,0"
                    Padding="20,10" FontSize="14" FontWeight="Bold"
                    Background="{StaticResource Accent}" Foreground="White" 
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>