<Window x:Class="Project1.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Project1.UI.ViewModels;assembly=Project1.UI"
        xmlns:entities="clr-namespace:Project1.Core.Entities;assembly=Project1.Core"
        xmlns:converters="clr-namespace:Project1.UI.Converters;assembly=Project1.UI"
        Title="Расписание Колледжа" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- ШАБЛОН КАРТОЧКИ ПАРЫ -->
        <DataTemplate x:Key="LessonCardTemplate">
            <Border Background="{Binding BlockColor}" CornerRadius="6" Margin="2" Padding="6" ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SubjectName}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" 
                               Foreground="White" VerticalAlignment="Top"/>

                    <TextBlock Grid.Row="1" Text="{Binding AudienceNumber}" FontSize="10" Foreground="#DDDDDD" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

                    <Button Content="✕" 
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="16" Height="16" 
                            Background="Transparent" Foreground="#FFAAAA" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold" FontSize="10"
                            Opacity="0.3"
                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.RequestDeleteLessonCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="LessonItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Grid.Row" Value="{Binding SlotIndex}"/>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ХЕДЕР -->
        <Grid Grid.Row="0" Background="{StaticResource BgCard}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="📅 Расписание Колледжа" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="{Binding Breadcrumbs}" FontSize="12" Foreground="{StaticResource TextMuted}" 
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="TxtUser" Text="Пользователь" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource TextMain}"/>
                <Button Content="Выйти" Style="{StaticResource AnimatedButton}" Click="BtnLogout_Click" Padding="10,5"/>

                <!-- КНОПКА СВЕРНУТЬ -->
                <Button Content="—" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                        FontSize="16" Margin="10,0,0,0" Click="BtnMinimize_Click" Cursor="Hand" ToolTip="Свернуть"/>

                <!-- КНОПКА ЗАКРЫТЬ -->
                <Button Content="✕" Background="Transparent" Foreground="{StaticResource Danger}" BorderThickness="0" 
                        FontSize="16" Margin="10,0,0,0" Click="BtnClose_Click" Cursor="Hand" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <!-- ОСНОВНАЯ ЧАСТЬ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- САЙДБАР -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <StackPanel Margin="15">
                    <TextBlock Text="МЕНЮ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                    <!-- Расписание -->
                    <Button Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3.01,3.9 3.01,5L3,19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M19,19H5V8H19V19Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Расписание" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Добавить пару -->
                    <Button x:Name="BtnAddLesson" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="BtnAddLesson_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Добавить пару" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Экспорт PDF -->
                    <Button x:Name="BtnReportPdf" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="BtnReportPdf_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H10.5V12H13.5V15H16L12,19Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Экспорт PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Экспорт Excel -->
                    <Button x:Name="BtnReportExcel" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="BtnReportExcel_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,19L8,15H10.5V12H13.5V15H16L12,19Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Экспорт Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Свободные кабинеты -->
                    <Button x:Name="BtnFreeAudiences" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenFreeAudiences_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.09,8.59L17.5,10L11,16.5Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Свободные кабинеты" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Журнал действий -->
                    <Button x:Name="BtnAuditLog" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenAuditLog_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M16,11V9.5L14,8V11H16M9,13H15V15H9V13Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Журнал действий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Управление практикой -->
                    <Button x:Name="BtnPractice" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenPracticeManager_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Управление практикой" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Пользователи -->
                    <Button x:Name="BtnManageUsers" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenManageUsers_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Пользователи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Предметы -->
                    <Button x:Name="BtnManageSubjects" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenManageSubjects_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V20.5C2.45,19.4 4.55,19 6.5,19C8.45,19 10.55,19.4 12,20.5V6.5C10.55,5.4 8.45,5 6.5,5Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Предметы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Преподаватели -->
                    <Button x:Name="BtnManageTeachers" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenManageTeachers_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,3A4,4 0 0,1 16,7A4,4 0 0,1 12,11A4,4 0 0,1 8,7A4,4 0 0,1 12,3M12,13C16.42,13 20,14.79 20,17V21H4V17C4,14.79 7.58,13 12,13Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Преподаватели" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Аудитории -->
                    <Button x:Name="BtnManageAudiences" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenManageAudiences_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M19,19H5V5H19V19M12,17L7,12H11V6H13V12H17L12,17Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Аудитории" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Группы -->
                    <Button x:Name="BtnManageGroups" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenManageGroups_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C4.17,8 3.5,8.67 3.5,9.5C3.5,10.33 4.17,11 5,11C5.83,11 6.5,10.33 6.5,9.5C6.5,8.67 5.83,8 5,8M19,8C18.17,8 17.5,8.67 17.5,9.5C17.5,10.33 18.17,11 19,11C19.83,11 20.5,10.33 20.5,9.5C20.5,8.67 19.83,8 19,8M5,13C5,14.11 5.9,15 7,15H17C18.1,15 19,14.1 19,13V12H5V13M12,14C9.79,14 8,15.79 8,18V20H16V18C16,15.79 14.21,14 12,14Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Группы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Бэкап -->
                    <Button x:Name="BtnBackup" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="BtnBackup_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M15,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V9L15,3M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M15,9H5V5H15V9Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Создать бэкап" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Восстановить -->
                    <Button x:Name="BtnRestore" Visibility="Collapsed" Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="BtnRestore_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4M12,10V12H8V16H12V18L16,14L12,10Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Восстановить БД" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- О программе -->
                    <Button Style="{StaticResource AnimatedButton}" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Foreground="{StaticResource TextMain}" Click="OpenAbout_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M13,9H11V7H13M13,17H11V11H13M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Fill="{StaticResource Accent}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="О программе" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- КОНТЕНТНАЯ ОБЛАСТЬ -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ФИЛЬТРЫ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Группа:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Width="120" Margin="0,0,15,0"
              Background="#334155" Foreground="White" BorderBrush="#475569">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#6366F1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Преподаватель:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}" Width="200" Margin="0,0,15,0"
              Background="#334155" Foreground="White" BorderBrush="#475569">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#6366F1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" Foreground="White"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="Сбросить фильтр" Command="{Binding ResetFiltersCommand}" Style="{StaticResource AnimatedButton}" Padding="10,5"/>
                </StackPanel>

                <!-- БАННЕР ПРАКТИКИ -->
                <Border Grid.Row="1" 
                        Visibility="{Binding IsPracticeMode, Converter={StaticResource BoolToVis}}"
                        Background="#8B5CF6" CornerRadius="12" Padding="40" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPracticeHeader}" FontSize="32" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPracticeInfo}" FontSize="18" Foreground="#DDD6FE" 
                                   HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- СЕТКА РАСПИСАНИЯ -->
                <Border Grid.Row="1" 
                        Visibility="{Binding IsPracticeMode, Converter={StaticResource InverseBoolToVis}}"
                        Background="{StaticResource BgCard}" CornerRadius="12" Padding="10">

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Время" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Понедельник" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Вторник" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Среда" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Четверг" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="Пятница" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="08:00 - 08:45" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="08:55 - 09:40" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="09:50 - 10:35" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="10:45 - 11:30" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="11:40 - 12:25" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="12:35 - 13:20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="13:30 - 14:15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="14:25 - 15:10" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="15:20 - 16:05" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11"/>
