<Window x:Class="Project1.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Canvas>
            <Ellipse Width="300" Height="300" Fill="#6366F1" Opacity="0.2">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="50" To="200" Duration="0:0:5" />
                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="50" To="150" Duration="0:0:7" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Ellipse Width="400" Height="400" Fill="#10B981" Opacity="0.1" Canvas.Left="400" Canvas.Top="200">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="400" To="300" Duration="0:0:6" />
                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)" From="200" To="300" Duration="0:0:8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Canvas>

        <Border Width="400" Height="500" Background="#1E293B" CornerRadius="16" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="50" To="0" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel Margin="40" VerticalAlignment="Center">
                <TextBlock Text="Расписание Колледжа" FontSize="28" Foreground="#F1F5F9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Логин" Foreground="#94A3B8" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLogin" Height="40" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155" BorderThickness="1" Padding="10,0" FontSize="14" VerticalContentAlignment="Center"/>

                <TextBlock Text="Пароль" Foreground="#94A3B8" Margin="0,15,0,5"/>

                <Grid>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Height="40">
                        <Grid>
                            <TextBox x:Name="TxtPasswordVisible" Background="Transparent" Foreground="#F1F5F9" BorderThickness="0" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <PasswordBox x:Name="TxtPassword" Background="Transparent" Foreground="#F1F5F9" BorderThickness="0" Padding="10,0" FontSize="14" VerticalContentAlignment="Center"/>

                            <Button x:Name="BtnTogglePassword" Content="👁" HorizontalAlignment="Right" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" Cursor="Hand" Margin="0,0,10,0" Click="BtnTogglePassword_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="TxtError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <Button x:Name="BtnLogin" Content="ВОЙТИ" Height="45" Margin="0,25,0,0" Background="#6366F1" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- СПИННЕР ЗАГРУЗКИ -->
                <Control x:Name="LoadingSpinner" Style="{StaticResource Spinner}" 
                         HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed"/>

                <Button x:Name="BtnGuestLogin" Content="Войти как студент (Гость)" Height="35" Margin="0,10,0,0" Background="Transparent" Foreground="#94A3B8" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnGuestLogin_Click"/>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Margin="0,-460,-20,0" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>