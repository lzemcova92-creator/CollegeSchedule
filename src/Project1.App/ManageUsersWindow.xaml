<Window x:Class="Project1.App.ManageUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E293B" Foreground="#E2E8F0"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="👥 Управление пользователями" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource Danger}" BorderThickness="0" FontSize="16" Click="Close_Click" Cursor="Hand"/>
            </Grid>

            <!-- Форма добавления/редактирования -->
            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="➕ Добавить пользователя" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="White"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Логин:" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtLogin" Background="#334155" Foreground="White" BorderBrush="#475569" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Пароль:" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtPassword" Background="#334155" Foreground="White" BorderBrush="#475569" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Label Content="ФИО:" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtFullName" Background="#334155" Foreground="White" BorderBrush="#475569" Height="30" Padding="5,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <Label Content="Роль:" Foreground="#94A3B8"/>
                            <ComboBox x:Name="CmbRole" Background="#334155" Foreground="White" BorderBrush="#475569" Height="30">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="8,5"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnCancelEdit" Content="Отмена" Click="BtnCancelEdit_Click" 
                                Visibility="Collapsed" Background="#475569" Foreground="White" BorderThickness="0" Padding="15,5" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" 
                                Background="#6366F1" Foreground="White" BorderThickness="0" Padding="15,5" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Таблица пользователей -->
            <DataGrid x:Name="DgUsers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" RowHeight="40"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      MouseDoubleClick="DgUsers_MouseDoubleClick" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="100"/>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#334155"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Футер с кнопками -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" Margin="0,15,0,0">
                <Button Content="✏️ Редактировать" Click="BtnEdit_Click" 
                        Background="#F59E0B" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="🗑️ Удалить выбранное" Click="BtnDelete_Click" 
                        Background="#EF4444" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="Закрыть" Click="Close_Click" 
                        Background="#334155" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>