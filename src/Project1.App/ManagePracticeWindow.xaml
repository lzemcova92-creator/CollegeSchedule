<Window x:Class="Project1.App.ManagePracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление практикой" Height="550" Width="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Форма добавления/редактирования -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <!-- ЗАГОЛОВОК С КРЕСТИКОМ -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="FormTitle" Text="➕ Назначить практику" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Background="Transparent" Foreground="#EF4444" BorderThickness="0" 
                                FontSize="16" Click="Close_Click" Cursor="Hand"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Группа -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Группа:" Foreground="#94A3B8"/>
                            <ComboBox x:Name="CmbGroup" Background="#334155" Foreground="White" BorderBrush="#475569">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Дата начала -->
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Начало (дд.мм.гггг):" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtStartDate" Background="#334155" Foreground="White" BorderBrush="#475569" 
                                     VerticalContentAlignment="Center" Height="30" Padding="5,0" Text="01.01.2026"/>
                        </StackPanel>

                        <!-- Дата конца -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Окончание (дд.мм.гггг):" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtEndDate" Background="#334155" Foreground="White" BorderBrush="#475569" 
                                     VerticalContentAlignment="Center" Height="30" Padding="5,0" Text="01.02.2026"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Тип -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Тип:" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtType" Text="Производственная" 
                                     Background="#334155" Foreground="White" BorderBrush="#475569"
                                     VerticalContentAlignment="Center" Height="30" Padding="5,0"/>
                        </StackPanel>

                        <!-- Комментарий -->
                        <StackPanel Grid.Column="1">
                            <Label Content="Комментарий:" Foreground="#94A3B8"/>
                            <TextBox x:Name="TxtComment" AcceptsReturn="True" MaxHeight="60"
                                     Background="#334155" Foreground="White" BorderBrush="#475569"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnCancelEdit" Content="Отмена" Click="BtnCancelEdit_Click" 
                                Visibility="Collapsed" Background="#475569" Foreground="White" BorderThickness="0" Padding="15,5" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" 
                                Background="#6366F1" Foreground="White" BorderThickness="0" Padding="15,5" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список активных практик -->
            <DataGrid x:Name="DgPractices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" RowHeight="40"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      MouseDoubleClick="DgPractices_MouseDoubleClick" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="80"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Конец" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#334155"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <!-- Стиль строк -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Футер с кнопками -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,15,0,0">
                <Button Content="✏️ Редактировать" Click="BtnEdit_Click" 
                        Background="#F59E0B" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="🗑️ Удалить выбранное" Click="BtnDeleteSelected_Click" 
                        Background="#EF4444" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="❌ Полная очистка" Click="BtnClearAll_Click" 
                        Background="#DC2626" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                <!-- Убрал кнопку "Закрыть" отсюда, так как теперь есть крестик вверху, но если хотите оставить, можете вернуть -->
            </StackPanel>
        </Grid>
    </Border>
</Window>