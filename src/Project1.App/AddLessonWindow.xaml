<Window x:Class="Project1.App.AddLessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление пары" Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Новая пара" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource Danger}" BorderThickness="0" FontSize="16" Click="BtnClose_Click" Cursor="Hand"/>
            </Grid>

            <!-- Форма -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Чекбокс "Обед" -->
                    <CheckBox x:Name="ChkLunch" Content="Это обед (без преподавателя и аудитории)" 
                              Foreground="White" Margin="0,0,0,15" 
                              Checked="ChkLunch_Checked" Unchecked="ChkLunch_Unchecked"/>

                    <TextBlock Text="Группа:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbGroup" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Блок с предметом (скрывается для обеда) -->
                    <StackPanel x:Name="SubjectBlock">
                        <TextBlock Text="Предмет:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbSubject" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Блок с преподавателем (скрывается для обеда) -->
                    <StackPanel x:Name="TeacherBlock">
                        <TextBlock Text="Преподаватель:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbTeacher" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Блок с аудиторией (скрывается для обеда) -->
                    <StackPanel x:Name="AudienceBlock">
                        <TextBlock Text="Аудитория:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbAudience" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Number}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="День недели:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbDay" Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Время:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbTime" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>

                    <!-- Блок для вывода конфликтов -->
                    <Border x:Name="ErrorBorder" Background="#7F1D1D" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Отмена" Style="{StaticResource AnimatedButton}" Background="#334155" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource AnimatedButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>